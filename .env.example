# ─────────────────────────────────────────────────────────────────────────────
# 3VENI SPHERE — environment configuration. Copy to .env.local (never commit real values).
# `npm run content:report` lists everything still missing; `npm run check:launch` gates a live build.
# ─────────────────────────────────────────────────────────────────────────────

# preview = shows marked [CLIENT TO PROVIDE] slots, site is noindex and robots disallow all.
# live    = empty slots are hidden, `npm run build` FAILS until domain + a contact channel + enquiry delivery exist.
CONTENT_MODE="preview"
# Audit-only switch: lets a preview build be indexable on a staging domain. Never set in production.
FORCE_INDEXABLE=""

# Public production domain (https, not localhost). Drives canonicals, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=""

# Public advisory channels — leave empty until verified. At least one is required for CONTENT_MODE=live.
CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_PHONE=""
CONTACT_EMAIL=""
WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_OFFICE_ADDRESS=""
NEXT_PUBLIC_OFFICE_HOURS=""

# Enquiry delivery (server-only — never prefix with NEXT_PUBLIC_). Configure SMTP, a CRM webhook, or both.
ENQUIRY_RECIPIENT_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
CRM_WEBHOOK_URL=""
CRM_API_KEY=""

# Optional: https origins allowed to iframe this site, comma-separated. Default: none (frame-ancestors 'self').
EMBED_ALLOWED_ORIGINS=""

# Optional: plots per page on /projects (default 6).
LISTING_PAGE_SIZE=""
