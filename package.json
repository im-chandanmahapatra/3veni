{
  "name": "3veni-sphere-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run check:launch && next build",
    "start": "node scripts/start.mjs",
    "clean": "rm -rf .next out",
    "lint": "eslint . && tsc --noEmit && node scripts/check-tokens.mjs",
    "test": "node --import tsx --import ./scripts/register-assets.mjs --test lib/__tests__/*.test.ts",
    "check:launch": "node --import tsx --import ./scripts/register-assets.mjs scripts/check-launch.ts",
    "content:report": "node --import tsx --import ./scripts/register-assets.mjs scripts/check-launch.ts --report"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/nodemailer": "^8.0.2",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.4.6",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "sharp": "^0.35.5"
  }
}
